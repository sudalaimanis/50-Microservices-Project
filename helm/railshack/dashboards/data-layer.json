    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "html",
    "content": "<div style=\"display:flex;align-items:center;gap:16px;padding:6px 4px\"><div style=\"font-size:26px;font-weight:700;color:#2563EB\">🚆 Data layer</div><div style=\"opacity:.75;font-size:14px\">PostgreSQL is the truth · Redis is the fast copy · read Redis first, write PostgreSQL first</div><div style=\"margin-left:auto;font-size:12px;opacity:.6\">RailShack · a DevOps Shack project · devopsshack.com</div></div>"
   },
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "The cache: Redis",
   "collapsed": false,
   "id": 2,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Redis",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "max(redis_up{namespace=\"$namespace\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#DC2626",
        "value": null
       },
       {
        "color": "#16A34A",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "#DC2626"
        },
        "1": {
         "text": "UP",
         "color": "#16A34A"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 3
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Hit ratio",
   "description": "Of all cache lookups, the share Redis answered. Each hit is one PostgreSQL query saved.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(redis_keyspace_hits_total{namespace=\"$namespace\"}[$__rate_interval])) / clamp_min(sum(rate(redis_keyspace_hits_total{namespace=\"$namespace\"}[$__rate_interval])) + sum(rate(redis_keyspace_misses_total{namespace=\"$namespace\"}[$__rate_interval])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#DC2626",
        "value": null
       },
       {
        "color": "#EA580C",
        "value": 0.5
       },
       {
        "color": "#16A34A",
        "value": 0.8
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 3,
    "y": 3
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Keys",
   "description": "pnr:<PNR> (10 min) and trips:<user> (5 min) copies.",
