  {
   "type": "timeseries",
   "title": "Hits vs misses / second",
   "description": "After FLUSHALL, misses jump and hits drop to zero; then the cache refills itself and hits come back.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(redis_keyspace_hits_total{namespace=\"$namespace\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "hits (served from Redis)"
    },
    {
     "refId": "B",
     "expr": "sum(rate(redis_keyspace_misses_total{namespace=\"$namespace\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "misses (went to PostgreSQL)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 35,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "hits (served from Redis)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#16A34A"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "misses (went to PostgreSQL)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#EA580C"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
