{
 "uid": "railshack-service",
 "title": "RailShack · Service deep dive",
 "description": "Everything about one microservice: traffic, errors, latency, pods, CPU, memory, restarts, version.",
 "tags": [
  "railshack",
  "devops-shack",
  "service"
 ],
 "editable": true,
 "graphTooltip": 1,
 "refresh": "10s",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "links": [
  {
   "title": "RailShack dashboards",
   "type": "dashboards",
   "tags": [
    "railshack"
   ],
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(railshack_up, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(railshack_up, namespace)",
    "refresh": 2,
    "current": {
     "text": "railshack",
     "value": "railshack"
    },
    "hide": 0
   },
   {
    "name": "service",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(railshack_up{namespace=\"$namespace\"}, service)",
     "refId": "svc"
    },
    "definition": "label_values(railshack_up{namespace=\"$namespace\"}, service)",
    "refresh": 2,
    "sort": 1,
    "current": {
     "text": "booking",
     "value": "booking"
    },
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "html",
    "content": "<div style=\"display:flex;align-items:center;gap:16px;padding:6px 4px\"><div style=\"font-size:26px;font-weight:700;color:#2563EB\">🚆 Service deep dive</div><div style=\"opacity:.75;font-size:14px\">Pick a service at the top. Every panel below follows it.</div><div style=\"margin-left:auto;font-size:12px;opacity:.6\">RailShack · a DevOps Shack project · devopsshack.com</div></div>"
   },
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "$service right now",
   "collapsed": false,
   "id": 2,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Status",
   "description": "UP when Prometheus can scrape at least one pod of this service.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{namespace=\"$namespace\",job=\"$service\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#DC2626",
        "value": null
       },
       {
        "color": "#16A34A",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "#DC2626"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 1,
        "to": 1000,
        "result": {
         "text": "UP",
         "color": "#16A34A"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 3
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Version",
   "description": "The image tag the pods run: sha-<commit> from CI.",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (version) (railshack_build_info{namespace=\"$namespace\",service=\"$service\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{version}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#0B2545"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 3,
    "y": 3
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Language",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (language) (railshack_up{namespace=\"$namespace\",service=\"$service\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{language}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#7C3AED"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 7,
    "y": 3
   },
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Pods ready",
   "description": "Ready pods vs the number the Deployment asks for.",
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=\"$service\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "ready"
    },
    {
     "refId": "B",
     "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=\"$service\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "desired"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#0B2545"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 10,
    "y": 3
   },
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Requests / second",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "fixed",
      "fixedColor": "#2563EB"
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 14,
    "y": 3
   },
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Error rate",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "(sum (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.01
       },
       {
        "color": "#DC2626",
        "value": 0.05
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 17,
    "y": 3
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Avg response",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum (rate(railshack_http_request_duration_seconds_sum{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])) / clamp_min(sum (rate(railshack_http_request_duration_seconds_count{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.2
       },
       {
        "color": "#DC2626",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 3
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Traffic",
   "collapsed": false,
   "id": 10,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 7
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Requests / second by status code",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code) (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 35,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "2.."
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#16A34A"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "4.."
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#CA8A04"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "5.."
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#DC2626"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Requests / second by method",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (method) (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{method}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Avg response time",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum (rate(railshack_http_request_duration_seconds_sum{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])) / clamp_min(sum (rate(railshack_http_request_duration_seconds_count{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "avg response time"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.2
       },
       {
        "color": "#DC2626",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "avg response time"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#2563EB"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Error rate",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "(sum (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum (rate(railshack_http_requests_total{namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])), 1e-9)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "5xx share"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.01
       },
       {
        "color": "#DC2626",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "5xx share"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#DC2626"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Pods and scaling",
   "collapsed": false,
   "id": 15,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Pods: desired, ready, autoscaler target",
   "description": "HPA lines appear only for services with autoscaling (the Black Friday profile).",
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=\"$service\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "desired"
    },
    {
     "refId": "B",
     "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=\"$service\"}",
     "datasource": {
