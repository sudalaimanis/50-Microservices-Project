    "x": 12,
    "y": 17
   },
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "piechart",
   "title": "By CPU architecture",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "count by (label_kubernetes_io_arch) (kube_node_labels)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
