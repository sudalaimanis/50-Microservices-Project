{
 "uid": "railshack-kubernetes",
 "title": "RailShack · Kubernetes & autoscaling",
 "description": "Nodes from EKS Auto Mode, pods, autoscalers and capacity. The Black Friday screen.",
 "tags": [
  "railshack",
  "devops-shack",
  "kubernetes"
 ],
 "editable": true,
 "graphTooltip": 1,
 "refresh": "10s",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "timezone": "browser",
 "timepicker": {
  "refresh_intervals": [
   "5s",
   "10s",
   "30s",
   "1m",
   "5m"
  ]
 },
 "links": [
  {
   "title": "RailShack dashboards",
   "type": "dashboards",
   "tags": [
    "railshack"
   ],
   "asDropdown": true,
   "includeVars": true,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(railshack_up, namespace)",
     "refId": "ns"
    },
    "definition": "label_values(railshack_up, namespace)",
    "refresh": 2,
    "current": {
     "text": "railshack",
     "value": "railshack"
    },
    "hide": 0
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "panels": [
  {
   "type": "text",
   "title": "",
   "transparent": true,
   "options": {
    "mode": "html",
    "content": "<div style=\"display:flex;align-items:center;gap:16px;padding:6px 4px\"><div style=\"font-size:26px;font-weight:700;color:#2563EB\">🚆 Kubernetes & autoscaling</div><div style=\"opacity:.75;font-size:14px\">EKS Auto Mode (managed Karpenter) adds nodes · HPAs add pods · watch both react</div><div style=\"margin-left:auto;font-size:12px;opacity:.6\">RailShack · a DevOps Shack project · devopsshack.com</div></div>"
   },
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Cluster capacity",
   "collapsed": false,
   "id": 2,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Nodes",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_node_info)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#0B2545"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 3
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Spot nodes",
   "description": "Cheaper, interruptible EC2 capacity (the blackfriday NodePool can use it).",
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_node_labels{label_karpenter_sh_capacity_type=\"spot\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#7C3AED"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 3,
    "y": 3
   },
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Pods running (all)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{phase=\"Running\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#0B2545"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 6,
    "y": 3
   },
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "stat",
   "title": "Pods pending",
   "description": "Pods waiting for room. Auto Mode reacts by launching a node, usually within a minute.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{phase=\"Pending\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds",
      "fixedColor": "#2563EB"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#EA580C",
        "value": 1
       },
       {
        "color": "#DC2626",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto",
    "wideLayout": true
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 9,
    "y": 3
   },
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "gauge",
   "title": "CPU requested",
   "description": "CPU that pods have reserved, out of what all nodes can offer. Auto Mode keeps this high to save money.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_container_resource_requests{resource=\"cpu\"}) / sum(kube_node_status_allocatable{resource=\"cpu\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.7
       },
       {
        "color": "#DC2626",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "showThresholdLabels": false,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 3
   },
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "gauge",
   "title": "Memory requested",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_container_resource_requests{resource=\"memory\"}) / sum(kube_node_status_allocatable{resource=\"memory\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.7
       },
       {
        "color": "#DC2626",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "showThresholdLabels": false,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 3
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "gauge",
   "title": "CPU actually used",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(container_cpu_usage_seconds_total{container!=\"\"}[5m])) / sum(kube_node_status_allocatable{resource=\"cpu\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#16A34A",
        "value": null
       },
       {
        "color": "#CA8A04",
        "value": 0.6
       },
       {
        "color": "#DC2626",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showThresholdMarkers": true,
    "showThresholdLabels": false,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 20,
    "y": 3
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "row",
   "title": "Nodes from EKS Auto Mode",
   "collapsed": false,
   "id": 10,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Nodes by NodePool",
   "description": "general-purpose and system are Auto Mode's built-in pools; blackfriday is ours (cluster/nodepool-blackfriday.yaml).",
   "targets": [
    {
     "refId": "A",
     "expr": "count by (label_karpenter_sh_nodepool) (kube_node_labels)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{label_karpenter_sh_nodepool}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 40,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "timeseries",
   "title": "Pending pods",
   "description": "A spike here followed by a step up in nodes is Auto Mode at work.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_pod_status_phase{phase=\"Pending\"}) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "pending"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 30,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": true,
      "lineInterpolation": "smooth",
      "stacking": {
       "mode": "none",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "pending"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#EA580C"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "piechart",
   "title": "By capacity type",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "count by (label_karpenter_sh_capacity_type) (kube_node_labels)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{label_karpenter_sh_capacity_type}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "pieType": "donut",
    "legend": {
     "displayMode": "table",
