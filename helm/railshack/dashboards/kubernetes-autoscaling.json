    "uid": "${datasource}"
   }
  },
  {
   "type": "table",
   "title": "Nodes",
   "description": "Every EC2 instance Auto Mode launched. Auto Mode replaces each node before it is 21 days old, for security patches.",
   "targets": [
    {
     "refId": "A",
     "expr": "max by (node, label_karpenter_sh_nodepool, label_node_kubernetes_io_instance_type, label_karpenter_sh_capacity_type, label_topology_kubernetes_io_zone) (kube_node_labels)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "expr": "count by (node) (kube_pod_info)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "expr": "sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"}) / sum by (node) (kube_node_status_allocatable{resource=\"cpu\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "E",
     "expr": "max by (node) (time() - kube_node_created)",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
