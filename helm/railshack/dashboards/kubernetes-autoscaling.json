   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 17
   },
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   }
  },
  {
   "type": "piechart",
